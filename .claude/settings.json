{
  "permissions": {
    "deny": [
      "Edit(src/pypeeker/check/**)",
      "Write(src/pypeeker/check/**)",
      "NotebookEdit(src/pypeeker/check/**)",
      "Edit(src/pypeeker/app/check_fixes.py)",
      "Write(src/pypeeker/app/check_fixes.py)",
      "Edit(src/pypeeker/app/privatize.py)",
      "Write(src/pypeeker/app/privatize.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precommit-gate.sh",
            "timeout": 120,
            "statusMessage": "Running pypeeker pre-commit gate..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/frozen-paths-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking frozen oracle paths..."
          }
        ]
      }
    ]
  }
}
